RewriteEngine On

# Use the non-www HTTPS domain as the single public URL.
RewriteCond %{HTTP_HOST} ^www\.chiaraalduini\.it$ [NC]
RewriteRule ^ https://chiaraalduini.it%{REQUEST_URI} [R=301,L]

# Avoid a duplicate homepage URL.
RewriteRule ^index\.html$ https://chiaraalduini.it/ [R=301,L]

# Preserve relevant links from the previous portfolio structure.
RewriteRule ^portfolio/items/istituto-distruzione-superiore-vincenzo-capirola/?$ /pages/case-capirola.html [R=301,L,NC]
RewriteRule ^portfolio/items/information-design-illustrazioni-iiot-2/?$ /pages/case-ultrafab.html [R=301,L,NC]
